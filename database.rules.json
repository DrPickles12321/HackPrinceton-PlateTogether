{
  "rules": {
    "familyCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users/' + auth.uid + '/patients/' + $uid).exists())",

        "email":               { ".read": "auth != null && (auth.uid === $uid || root.child('users/' + auth.uid + '/patients/' + $uid).exists())", ".write": "auth.uid === $uid" },
        "role":                { ".write": "auth.uid === $uid && !data.exists()" },
        "familyCode":          { ".write": "auth.uid === $uid" },
        "patients":            { ".write": "auth.uid === $uid" },
        "insights":            { ".write": "auth.uid === $uid" },
        "lastResetWeek":       { ".write": "auth.uid === $uid" },
        "mealLogs":            { ".write": "auth.uid === $uid" },
        "mealTimes":           { ".write": "auth.uid === $uid" },
        "supplementLog":       { ".write": "auth.uid === $uid" },
        "foodItems":           { ".write": "auth.uid === $uid" },
        "clinicianNotesRead":  { ".write": "auth.uid === $uid" },
        "savedClinicianNotes": { ".write": "auth.uid === $uid" },

        "nutritionalTargets":    { ".write": "auth.uid === $uid || root.child('users/' + auth.uid + '/patients/' + $uid).exists()" },
        "prescribedSupplements": { ".write": "auth.uid === $uid || root.child('users/' + auth.uid + '/patients/' + $uid).exists()" },
        "parentNotes":           { ".write": "auth.uid === $uid || root.child('users/' + auth.uid + '/patients/' + $uid).exists()" },
        "clinicianNotes":        { ".write": "root.child('users/' + auth.uid + '/patients/' + $uid).exists()" }
      }
    }
  }
}
