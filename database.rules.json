{
  "rules": {
    "familyCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false))",
        ".write": "auth.uid === $uid && !newData.exists()",

        "email":               { ".read": "auth != null && (auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false))", ".write": "auth.uid === $uid" },
        "role":                { ".write": "auth.uid === $uid && !data.exists()" },
        "familyCode":          { ".write": "auth.uid === $uid" },
        "patients": {
          ".write": "auth.uid === $uid",
          "$patientUid": {
            ".validate": "newData.hasChild('code') && root.child('familyCodes').child(newData.child('code').val()).val() === $patientUid"
          }
        },
        "careTeam": {
          "$clinicianUid": {
            ".write": "auth.uid === $uid || auth.uid === $clinicianUid",
            ".validate": "auth.uid === $uid || (!data.exists() && ((newData.hasChild('code') && root.child('familyCodes').child(newData.child('code').val()).val() === $uid) || root.child('users/' + $clinicianUid + '/patients/' + $uid).exists()))"
          }
        },
        "insights":            { ".write": "auth.uid === $uid" },
        "lastResetWeek":       { ".write": "auth.uid === $uid" },
        "mealLogs":            { ".write": "auth.uid === $uid" },
        "mealTimes":           { ".write": "auth.uid === $uid" },
        "supplementLog":       { ".write": "auth.uid === $uid" },
        "foodItems":           { ".write": "auth.uid === $uid" },
        "clinicianNotesRead":  { ".write": "auth.uid === $uid" },
        "savedClinicianNotes": { ".write": "auth.uid === $uid" },
        "hiddenClinicianNoteIds": { ".write": "auth.uid === $uid" },
        "consent":             { ".write": "auth.uid === $uid" },

        "nutritionalTargets":    { ".write": "auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false)" },
        "prescribedSupplements": { ".write": "auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false)" },
        "parentNotes":           { ".write": "auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false)" },
        "clinicianNotes":        { ".write": "root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false" },
        "sos":                   { ".write": "auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false)" },
        "assignedChallenges":    { ".write": "auth.uid === $uid || (root.child('users/' + auth.uid + '/patients/' + $uid).exists() && root.child('users/' + $uid + '/careTeam/' + auth.uid + '/active').val() !== false)" }
      }
    }
  }
}
